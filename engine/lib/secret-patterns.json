{
  "_why": "One list for the recorder (demo.ts, in the page) and the gate (secrets_scan.py, over the logs). A hit names the kind and the field, never the value.",
  "patterns": [
    { "kind": "jwt", "re": "eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}(?:\\.[A-Za-z0-9_-]*)?" },
    { "kind": "secret-key", "re": "\\bsk[_-](?:live|test|proj|ant|or)?[_-]?[A-Za-z0-9_-]{16,}" },
    { "kind": "github-token", "re": "\\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})" },
    { "kind": "slack-token", "re": "\\bxox[abposr]-[A-Za-z0-9-]{10,}" },
    { "kind": "aws-key", "re": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b" },
    { "kind": "bearer", "re": "\\bBearer\\s+[A-Za-z0-9._~+/=-]{16,}" },
    { "kind": "query-secret", "re": "[?&;](?:token|key|api_key|apikey|access_token|secret|code|password|sig|signature)=[^&\\s#\"']{8,}" },
    { "kind": "private-key", "re": "-----BEGIN [A-Z ]*PRIVATE KEY-----" }
  ],
  "entropy": {
    "run": "[A-Za-z0-9_+/=-]{24,}",
    "min_len": 24,
    "min_bits": 3.6,
    "min_classes": 3,
    "hex_min_len": 32,
    "hex_min_bits": 3.0
  }
}
